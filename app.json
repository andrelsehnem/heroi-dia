{
  "expo": {
    "name": "Herói do Dia",
    "slug": "heroi-do-dia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "com.heroidodia.app"
    },
    "ios": {
      "bundleIdentifier": "com.heroidodia.app"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ]
  }
}
